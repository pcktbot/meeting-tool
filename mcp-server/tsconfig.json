{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "drizzle-orm": ["../node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../node_modules/drizzle-orm/*"]
    }
  },
  "include": ["src", "../src/db/schema.ts"]
}
